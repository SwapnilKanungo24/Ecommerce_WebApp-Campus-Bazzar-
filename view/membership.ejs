<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Membership Plans</title>
    <link rel="stylesheet" href="stylemem.css">
</head>
<body>
    <section class="membership">
        <div class="container">
            <h1 class="title">Find the Perfect Plan for You</h1>
            <p class="subtitle">Choose a membership that suits your needs and start today!</p>
            <div class="plans">
                <!-- Basic Plan -->
                <div class="plan">
                    <div class="plan-header">
                        <h2 class="plan-title">Basic</h2>
                        <p class="plan-price">Rs15/month</p>
                    </div>
                    <div class="plan-body">
                        <ul class="features">
                            <li>Access to core features</li>
                            <li>5GB storage</li>
                            <li>Email support</li>
                        </ul>
                        <a href="#" class="button">Choose Plan</a>
                    </div>
                </div>
                <!-- Premium Plan -->
                <div class="plan featured">
                    <div class="plan-header">
                        <h2 class="plan-title">Premium</h2>
                        <p class="plan-price">Rs30/month</p>
                        <p class="badge">Most Popular</p>
                    </div>
                    <div class="plan-body">
                        <ul class="features">
                            <li>Everything in Basic</li>
                            <li>50GB storage</li>
                            <li>Priority email support</li>
                            <li>Custom templates</li>
                        </ul>
                        <a href="#" class="button">Choose Plan</a>
                    </div>
                </div>
                <!-- VIP Plan -->
                <div class="plan">
                    <div class="plan-header">
                        <h2 class="plan-title">VIP</h2>
                        <p class="plan-price">Rs60/month</p>
                    </div>
                    <div class="plan-body">
                        <ul class="features">
                            <li>Everything in Premium</li>
                            <li>Unlimited storage</li>
                            <li>24/7 support</li>
                            <li>Dedicated account manager</li>
                        </ul>
                        <a href="#" class="button">Choose Plan</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
