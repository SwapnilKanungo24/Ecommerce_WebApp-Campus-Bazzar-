<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= product.title %> - Campus Bazzar</title>
  <link rel="stylesheet" href="/home.css">
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #eef2f7;
      color: #333;
    }
    .product-detail-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: flex-start;
      padding: 40px;
      gap: 40px;
      background: linear-gradient(to right, #f0f2f5, #e0e7ff);
      min-height: 100vh;
    }
    .product-detail-image img {
      max-width: 500px;
      width: 100%;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
      transition: transform 0.3s ease;
    }
    .product-detail-image img:hover {
      transform: scale(1.05);
    }
    .product-detail-info {
      max-width: 600px;
      background: #fff;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 8px 16px rgba(0,0,0,0.1);
      transition: box-shadow 0.3s ease;
    }
    .product-detail-info:hover {
      box-shadow: 0 12px 24px rgba(0,0,0,0.15);
    }
    .product-detail-info h1 {
      margin-bottom: 20px;
      font-size: 2rem;
      color: #2c3e50;
    }
    .product-detail-info p {
      margin: 12px 0;
      font-size: 1.1rem;
    }
    .product-detail-info strong {
      color: #555;
    }
    .btn {
      margin-top: 25px;
      padding: 12px 25px;
      background: #4CAF50;
      color: #fff;
      font-size: 1.1rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s ease, transform 0.2s ease;
    }
    .btn:hover {
      background-color: #45a049;
      transform: translateY(-2px);
    }
    .contact-buttons {
      display: flex;
      gap: 15px;
      margin-top: 20px;
    }
    .contact-btn {
      padding: 10px 18px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 1rem;
      transition: background 0.3s ease, transform 0.2s ease;
    }
    .contact-btn.email {
      background: #3498db;
      color: #fff;
    }
    .contact-btn.phone {
      background: #e67e22;
      color: #fff;
    }
    .contact-btn:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }

    .contact-btn.chat {
        background: #8e44ad; /* Purple color */
        color: #fff;
        width: 100%; /* Full width for a long rectangle */
        padding: 15px;
        font-size: 1.2rem;
        text-align: center;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.2s ease;
    }

    .contact-btn.chat:hover {
        background: #732d91; /* Darker purple on hover */
        transform: translateY(-2px);
    }
  </style>
</head>
<body>
  <div class="product-detail-container">
    <div class="product-detail-image">
      <img src="<%= product.image %>" alt="<%= product.title %>">
    </div>
    <div class="product-detail-info">
      <h1><%= product.title %></h1>
      <p><strong>Price:</strong> ₹<%= product.price %></p>
      <p><strong>Description:</strong> <%= product.description %></p>
      <p><strong>Category:</strong> <%= product.category %></p>
      <div class="contact-buttons">
        <button class="contact-btn email" onclick="window.location.href='mailto:<%= product.sellerEmail %>'">Email Seller</button>
        <button class="contact-btn phone" onclick="window.location.href='tel:<%= product.sellerPhone %>'"><%= product.sellerPhone %> Call Seller</button>
        <button class="contact-btn chat" onclick="window.location.href='/chat'">Chat with Seller</button>
      </div>
    </div>
  </div>
</body>
</html>
