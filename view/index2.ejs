            <div class="item">
                <img src="./images/tools.webp" alt="Engineering drawing tools">
                <h3>Engineering drawing tools</h3>
                <p>₹80</p>
            </div>
            <div class="item">
                <img src="./images/school-college-bag.jpg" alt="college Bag">
